{{ == head("Neuen Merch erstellen") }}

<form action="{{ route('merchs.store') }}" method="post">
    <label for="title" class="required">Titel</label>
    <input type="text" id="title" name="title" required minlength="3" maxlength="40">

    <label class="required">Größen</label>

    {{ each: $sizes as $size }}
        <label for="sizes-{{ $size->value }}">
            <input type="checkbox" id="sizes-{{ $size->value }}"
                name="sizes[]" value="{{ $size->value }}">
            {{ $size->label() }}
        </label>
    {{ each; }}

    <button type="submit" class="btn mt-2">Speichern</button>
</form>
