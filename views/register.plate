{{ == head("Registrieren bei ".config('title')) }}

{{ each: $errors ?? [] as $error }}
    <div class="notification"><p class="m-0 p-0">{{ $error }}</p></div>
{{ each; }}

<form action="/register" method="post">
    <label for="email" class="required">E-Mail-Adresse</label>
    <input type="email" id="email" name="email" required minlength="6" maxlength="50">

    <label for="first_name" class="required">Vorname</label>
    <input type="text" id="first_name" name="first_name" required minlength="3" maxlength="40">

    <label for="last_name" class="required">Nachname</label>
    <input type="text" id="last_name" name="last_name" required minlength="3" maxlength="40">

    <label for="password" class="required">Passwort</label>
    <input type="password" id="password" name="password" required minlength="8" maxlength="100">

    <button type="submit" class="btn mt-2">Login</button>
</form>
