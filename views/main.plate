{{ plug: 'head', title: "Merch-Bestellungen" }}

{{ if: $order }}
    <p class="mt"><b>Folgende Bestellung ist gerade geöffnet:</b></p>

    <p class="row" style="justify-content: center">
        <a class="btn mt" href="{{ route('items.create', id: $order->id) }}">
            {{ $order->title }}
        </a>
    </p>

    {{ if: $order->info }}
        <p class="mt">{{ $order->info }}</p>
    {{ if; }}
{{ else: }}
    <p>Es sieht so aus, als könnte man derzeit nichts bestellen.</p>
{{ if; }}
