{{ plug: 'head', title: "Neue Bestellung eröffnen" }}

<form action="{{ route('orders.store') }}" method="post">
    <label for="title" class="required">Titel</label>
    <input type="text" id="title" name="title" required minlength="3" maxlength="40">

    <button type="submit" class="btn mt-2">Speichern</button>
</form>
