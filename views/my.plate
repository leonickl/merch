{{ plug: 'head', title: "Meine Bestellungen" }}

<div class="cards">
    {{ if: count($items) === 0 }}
        <p>Du hast noch nichts bestellt.</p>
    {{ if; }}

    {{ each: $items as $item }}
        <div class="card">
            <p><b>{{ $item->merch()->title }}</b></p>

            {{ if: $item->size }}
                <p>Größe: {{ $item->size()?->label() ?: '---' }}</p>
            {{ if; }}

            <p><em>{{ $item->createdAt() }}</em></p>

            {{ if: $item->order()->paylink }}
                <p class="mt">
                    <a href="{{ $item->order()->paylink() }}" class="btn">
                        {{ plug: 'icons.paypal' }}
                        {{ $item->order()->paylink(protocol: false) }}
                    </a>
                </p>
            {{ if; }}
        </div>
    {{ each; }}
</div>
