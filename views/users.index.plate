{{ plug: 'head', title: "Benutzer-Übersicht" }}

<div class="cards">
    {{ each: $users as $user }}
        <div class="card">
            <p><b>{{ $user->name() }}</b></p>

            <p>
                {{ $user->username }}

                {{ if: $user->verified }}
                    {{ plug: 'icons.verified' }}
                {{ if; }}
            </p>

            {{ if: $user->role === 0 }}
                <a href="{{ route('users.set-role', id: $user->id) }}?__method=post&role=1" class="btn secondary mt-2">Benutzer:in</a>
            {{ elif: $user->role === 1 }}
                <a href="{{ route('users.set-role', id: $user->id) }}?__method=post&role=2" class="btn mt-2">Organisator:in</a>
            {{ elif: $user->role === 2 }}
                <a href="{{ route('users.set-role', id: $user->id) }}?__method=post&role=0" class="btn warn mt-2">Admin</a>
            {{ if; }}
        </div>
    {{ each; }}
</div>
