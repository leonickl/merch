{{ plug: 'head', title: "Benutzer-Übersicht" }}

<div class="cards">
    {{ each: $users as $user }}
        <div class="card">
            <p><b>{{ $user->fullName() }}</b></p>

            <p>
                {{ $user->username }}

                {{ if: $user->verified }}
                    {{ plug: 'icons.verified' }}
                {{ if; }}
            </p>

            {{ if: $user->role === \App\Enums\Role::REGULAR->value }}
                <a href="{{ route('users.set-role', id: $user->id) }}?__method=post&role={{ \App\Enums\Role::ORGA->value }}" class="btn secondary mt-2">Benutzer:in</a>
            {{ elif: $user->role === \App\Enums\Role::ORGA->value }}
                <a href="{{ route('users.set-role', id: $user->id) }}?__method=post&role={{ \App\Enums\Role::ADMIN->value }}" class="btn mt-2">Organisator:in</a>
            {{ elif: $user->role === \App\Enums\Role::ADMIN->value }}
                <a href="{{ route('users.set-role', id: $user->id) }}?__method=post&role={{ \App\Enums\Role::REGULAR->value }}" class="btn warn mt-2">Admin</a>
            {{ if; }}
        </div>
    {{ each; }}
</div>
